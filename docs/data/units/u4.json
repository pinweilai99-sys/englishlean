    {
      "id": "IX",
      "title": "Emma 的魔法书包",
      "titleEn": "Emma's Magic Schoolbag",
      "text": "Emma has a new schoolbag. There is a Chinese book, a dictionary, two notebooks and a big pencil case in it. What's in the big pencil case? She takes out a pencil. The pencil sharpens itself! \"Oh, no, I forgot my ruler. Can I use yours, please?\" Mike asks. Emma gives him the ruler. It changes to the right length. Mike writes a wrong word. Emma takes out her eraser to help him. They take out a brush. The brush paints colourful lines by itself. They do their homework with the magic things in the schoolbag. Suddenly, Emma wakes up. It's only a dream! \"What a fun dream!\"",
      "tasks": [
        "跟读 3 遍",
        "演一演：魔法文具都有什么本领？"
      ],
      "narration": "",
      "narrationZh": "",
      "lines": [
        {
          "who": "🎒 旁白",
          "t": "Emma has a new schoolbag. There is a Chinese book, a dictionary, two notebooks and a big pencil case in it.",
          "zh": "Emma 有一个新书包。里面有一本语文书、一本词典、两个笔记本和一个大文具盒。"
        },
        {
          "who": "🎒 旁白",
          "t": "What's in the big pencil case? She takes out a pencil. The pencil sharpens itself!",
          "zh": "大文具盒里有什么？她拿出一支铅笔。铅笔自己变尖了！"
        },
        {
          "who": "🧒 Mike",
          "t": "Oh, no, I forgot my ruler. Can I use yours, please?",
          "zh": "哦，不好，我忘带尺子了。我能用一下你的吗？"
        },
        {
          "who": "🎒 旁白",
          "t": "Emma gives him the ruler. It changes to the right length.",
          "zh": "Emma 把尺子递给他。尺子变到了合适的长度。"
        },
        {
          "who": "🎒 旁白",
          "t": "Mike writes a wrong word. Emma takes out her eraser to help him.",
          "zh": "Mike 写错了一个单词。Emma 拿出橡皮帮他。"
        },
        {
          "who": "🎒 旁白",
          "t": "They take out a brush. The brush paints colourful lines by itself.",
          "zh": "他们拿出一支画笔。画笔自己画出了彩色的线条。"
        },
        {
          "who": "🎒 旁白",
          "t": "They do their homework with the magic things in the schoolbag.",
          "zh": "他们用书包里的魔法文具做作业。"
        },
        {
          "who": "🎒 旁白",
          "t": "Suddenly, Emma wakes up. It's only a dream! What a fun dream!",
          "zh": "忽然，Emma 醒了。这只是一场梦！多么有趣的梦啊！"
        }
      ],
